objtype=$cputype
path=(/$cputype/bin /rc/bin .)
NPROC=1
cd /tmp
cp /.smoke.c smoke.c
echo '</$objtype/mkfile
TARG=smoke
OFILES=smoke.$O
</sys/src/cmd/mkone' >mkfile
mk install 'BIN=/tmp'
./smoke
ip/ipconfig -g 10.0.2.2 ether /net/ether0 10.0.2.15 255.255.255.0
ip/ping -n 3 10.0.2.2
echo 'smoke: network ok'
