#!/usr/bin/env python3
# assys command [arg ...]: run command as sys (110000), when root,
# with the tree's umask
import os, sys

if len(sys.argv) < 2:
	sys.exit('usage: assys command [arg ...]')
os.umask(0o002)
if os.geteuid() == 0:
	os.setgroups([])
	os.setgid(110000)
	os.setuid(110000)
os.execvp(sys.argv[1], sys.argv[1:])
