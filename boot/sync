#!/usr/bin/env python3
"""usage: boot/sync [-w] [-x path]... root

Update the 9front tree root (a 9front-fs image's /9front) to this
checkout's HEAD, from the tree's commit (its
dist/9front/.git/refs/heads/front), which must be in this repository,
as 9front's git/pull and git/branch would, but with the host's git,
in seconds.  With -w, the files are the working tree's (tracked and
untracked but not ignored), and the tree's repository still moves
to HEAD, so 9front's git/diff shows the difference.

- only the files that differ are written, with git's modes as 664 or
  775 and the time now; new files and directories belong to sys,
  changed files keep their owners;
- files edited in the tree get a three-way merge (git merge-file);
  a conflict, or a file edited in the tree but removed here, fails;
  files changed here but absent from the tree stay absent;
- removed files are removed;
- the tree's repository moves to HEAD: a pack of the new objects,
  refs/heads/front, and INDEX9 lines, as git/branch writes them;
- /sys/lib/rootstub makes the directories every objtype installs into.

The top-level paths boot, .github and AGENTS.md, this host's, and
any named with -x are left out of the tree, but not of its repository.
"""
import getopt, hashlib, os, shutil, stat, subprocess, sys, tempfile

SYS = 110000
EXCLUDE = ['boot', '.github', 'AGENTS.md']
GIT = 'dist/9front/.git'


def die(msg):
    sys.exit('boot/sync: ' + msg)


def run(*cmd, input=None, check=True, **kw):
    r = subprocess.run(cmd, input=input, stdout=subprocess.PIPE, **kw)
    if check and r.returncode:
        die(f'{cmd[0]} {cmd[1]} failed')
    return r


def diff(git, a, b):
    # :OLDMODE NEWMODE OLDID NEWID STATUS\0PATH\0, for files only
    raw = git('diff', '--raw', '-z', '--no-renames', '--no-abbrev', a, b).split(b'\0')
    changes = []
    for meta, p in zip(raw[0::2], raw[1::2]):
        om, nm, oid, nid, st = meta.decode()[1:].split()
        changes.append((os.fsdecode(p), om, nm, oid, nid, st))
    return changes


def worktree(git, src):
    # the working tree as a tree object, staged in a copy of the index
    with tempfile.TemporaryDirectory() as td:
        index = git('rev-parse', '--path-format=absolute', '--git-path', 'index').decode().strip()
        if os.path.exists(index):
            shutil.copyfile(index, f'{td}/index')
        env = dict(os.environ, GIT_INDEX_FILE=f'{td}/index')
        run('git', '-C', src, 'add', '-A', env=env)
        return run('git', '-C', src, 'write-tree', env=env).stdout.decode().strip()


def main(root, work, exclude):
    src = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    git = lambda *a, **k: run('git', '-C', src, *a, **k).stdout
    fmt = git('rev-parse', '--show-object-format').decode().strip()
    blobid = lambda d: hashlib.new(fmt, b'blob %d\0' % len(d) + d).hexdigest()
    owner = os.geteuid() == 0
    at = lambda p: os.path.join(root, p)

    def chown(p, uid, gid):
        if owner:
            os.lchown(p, uid, gid)

    def write(p, data, mode, link=None):
        # a new inode, then the old one's owner, else sys's
        old = os.lstat(at(p)) if os.path.lexists(at(p)) else None
        tmp = at(p) + '.sync'
        if link is not None:
            os.symlink(link, tmp)
        else:
            with open(tmp, 'wb') as f:
                f.write(data)
            os.chmod(tmp, mode)
        chown(tmp, old.st_uid if old else SYS, old.st_gid if old else SYS)
        os.replace(tmp, at(p))

    try:
        seed = open(at(GIT + '/refs/heads/front')).read().strip()
    except OSError:
        die(f'{root}: no 9front tree')
    want = git('rev-parse', 'HEAD').decode().strip()
    if run('git', '-C', src, 'cat-file', '-e', seed + '^{commit}', check=False).returncode:
        die(f'the tree\'s commit {seed} is not in this repository: git fetch origin {seed}')
    files = worktree(git, src) if work else want
    changes = diff(git, seed, want)
    left = lambda p: p.split('/')[0] in exclude
    tree = [c for c in diff(git, seed, files) if not left(c[0])]
    if not tree and not changes:
        print('boot/sync: nothing to update', file=sys.stderr)
        return
    what = want[:9] + (' and the working tree' if work else '')

    def read(p):
        try:
            st = os.lstat(at(p))
        except FileNotFoundError:
            return None, None
        if stat.S_ISREG(st.st_mode):
            return st, open(at(p), 'rb').read()
        return st, None

    # check everything before writing anything
    plan, merged, absent, conflicts = [], [], [], []
    for p, om, nm, oid, nid, st in tree:
        h, cur = read(p)
        edited = h is not None and om.startswith('100') and (cur is None or blobid(cur) != oid)
        if st == 'D':
            if edited:
                conflicts.append(p + ': edited in the tree, removed in ' + what)
            elif h is not None:
                plan.append((p, None, None))
            continue
        if st == 'M' and h is None:
            absent.append(p)
            continue
        if nm.startswith('160'):                # a submodule: nothing to write
            continue
        data = git('cat-file', 'blob', nid)
        if edited and st == 'M' and blobid(cur) != nid:
            with tempfile.TemporaryDirectory() as td:
                for n, d in ('tree', cur), ('seed', git('cat-file', 'blob', oid)), ('new', data):
                    open(f'{td}/{n}', 'wb').write(d)
                r = run('git', 'merge-file', '-p', '-L', 'tree', '-L', seed[:9], '-L', what,
                        f'{td}/tree', f'{td}/seed', f'{td}/new', check=False)
            if r.returncode:
                conflicts.append(p + ': merge conflict')
                continue
            data = r.stdout
            merged.append(p)
        plan.append((p, nm, data))
    if conflicts:
        die('cannot update:\n\t' + '\n\t'.join(conflicts))

    for p, nm, data in plan:
        if nm is None or (os.path.lexists(at(p)) and not os.path.islink(at(p)) and os.path.isdir(at(p))):
            if os.path.isdir(at(p)) and not os.path.islink(at(p)):
                shutil.rmtree(at(p))
            elif os.path.lexists(at(p)):
                os.remove(at(p))
        if nm is None:
            continue
        d = os.path.dirname(p)
        missing = []
        while d and not os.path.isdir(at(d)):
            missing.append(d)
            d = os.path.dirname(d)
        for d in reversed(missing):
            if os.path.lexists(at(d)):
                os.remove(at(d))
            os.mkdir(at(d), 0o775)
            os.chmod(at(d), 0o775)
            chown(at(d), SYS, SYS)
        if nm == '120000':
            if os.path.lexists(at(p)):
                os.remove(at(p))
            write(p, None, None, link=os.fsdecode(data))
        else:
            write(p, data, 0o775 if nm == '100755' else 0o664)

    # the repository: the objects, front, and git/branch's INDEX9 lines
    if changes:
        pack = at(GIT + '/objects/pack')
        objs = git('rev-list', '--objects', f'{seed}..{want}')
        with tempfile.TemporaryDirectory() as td:
            name = run('git', '-C', src, 'pack-objects', '-q', f'{td}/p', input=objs).stdout.decode().strip()
            for ext in 'pack', 'idx':
                # named as 9front's git names them: no pack- prefix
                shutil.copyfile(f'{td}/p-{name}.{ext}', f'{pack}/{name}.{ext}')
                os.chmod(f'{pack}/{name}.{ext}', 0o664)
                chown(f'{pack}/{name}.{ext}', SYS, SYS)
        index = open(at(GIT + '/INDEX9'), 'rb').read() + b''.join(
            b'%s NOQID 0 %s\n' % (b'R' if c[5] == 'D' else b'T', os.fsencode(c[0])) for c in changes)
        write(GIT + '/INDEX9', index, 0o664)
        write(GIT + '/refs/heads/front', want.encode() + b'\n', 0o664)

    # the directories every objtype's builds install into, as sys
    def assys():
        os.umask(0o002)
        if owner:
            os.setgroups([])
            os.setgid(SYS)
            os.setuid(SYS)
    run('sh', '-c', '. sys/lib/rootstub', cwd=root, preexec_fn=assys)

    n = lambda s: sum(1 for c in tree if c[5] == s)
    print(f'boot/sync: {seed[:9]}..{what}: {n("A")} added, {n("M") + n("T")} changed, '
          f'{n("D")} removed, {len(merged)} merged', file=sys.stderr)
    for p in merged:
        print('boot/sync: merged:', p, file=sys.stderr)
    for p in absent:
        print('boot/sync: not in the tree, left out:', p, file=sys.stderr)


if __name__ == '__main__':
    try:
        opts, args = getopt.getopt(sys.argv[1:], 'wx:')
    except getopt.GetoptError:
        args = []
    if len(args) != 1:
        sys.exit(__doc__.split('\n\n')[0])
    main(os.path.realpath(args[0]), ('-w', '') in opts, EXCLUDE + [v for o, v in opts if o == '-x'])
