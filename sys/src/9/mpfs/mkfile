CONF=bvf
CONFLIST=bvf bvfcpuwait

# Microchip PolarFire SoC (BeagleV-Fire): the generic kernel in
# ../rva23 with this SoC's hart and PLIC layout (mem.h), RAM banks
# (mem.c), timer without Sstc (timecmp.c) and cache operations
# without Zicbom (cbo.c).  The board file (bvfboard.c) is named in
# the configuration.
#
# loadaddr is the link address (-T).  The kernel runs wherever it is
# loaded, fixing up its data pointers from the jl -u relocation table
# and binding memory layout to _start's runtime address; U-Boot loads
# it here, 2 MiB into its RAM bank, and booti runs it in place.
# CPU type		RAM base
# BeagleV-Fire		0x8a000000: the DDR from 160 MiB on, in the
#			HSS's cached window at 0x80000000
loadaddr=0x8a200000

objtype=riscv64
</$objtype/mkfile

SOCOBJ=\
	nopci.$O\

<../rva23/socmkfile

# mem.h overrides some of ../rva23/mem.h
$OBJ: mem.h

bvfcpuwait: bvf
	cp $prereq $target
