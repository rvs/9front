ARCH_386=pc xen
ARCH_amd64=pc64
ARCH_arm=bcm cycv kw omap teg2 zynq
ARCH_arm64=arm64 bcm64 imx8 lx2k
ARCH_mips=sgi
ARCH_power=
ARCH_power64=
ARCH_riscv64=rva23
ARCH_spim=mt7688

ARCH_all=\
	$ARCH_386\
	$ARCH_amd64\
	$ARCH_arm\
	$ARCH_arm64\
	$ARCH_mips\
	$ARCH_power\
	$ARCH_power64\
	$ARCH_riscv64\
	$ARCH_spim\

ARCHTYPE=all
ARCH=`{name=ARCH_^$ARCHTYPE; echo $$name}

all:V:
	for(i in $ARCH)@{
		cd $i
		mk
	}

install:V:
	for(i in $ARCH) @{
		cd $i
		mk install
	}

installall:V:
	for(i in $ARCH) @{
		cd $i
		mk installall
	}

clean:V:
	for(i in $ARCH) @{
		cd $i
		mk clean
	}
