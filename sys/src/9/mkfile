ARCH=\
	arm64\
	bcm64\
	bcm\
	cycv\
	imx8\
	kw\
	lx2k\
	mt7688\
	#mtx\
	omap\
	pc64\
	pc\
	#ppc\
	rva23\
	sgi\
	teg2\
	xen\
	zynq\

all:V:
	for(i in $ARCH)@{
		cd $i
		mk
	}

install:V:
	for(i in $ARCH) @{
		cd $i
		mk install
	}

installall:V:
	for(i in $ARCH) @{
		cd $i
		mk installall
	}

clean:V:
	for(i in $ARCH) @{
		cd $i
		mk clean
	}
