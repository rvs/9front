#!/bin/rc
# Diskless bring-up: no storage/network/DMA probes.
if(~ $#user 0)
	user=glenda
echo -n $user >/dev/hostowner
bind -qa '#t' /dev
bind -qa '#P' /dev
bind '#p' /proc
aux/kbdfs -q -s cons /dev/eia0
ramfs -m /tmp
prompt=('maxion9% ' '	')
echo '9front Maxion RAM-root ready'
echo 'CPU-only bring-up: no persistent disk, network, or DMA.'
smoke
exec /bin/rc -i </dev/cons >/dev/cons >[2=1]
