all:V: $PROGS

git: git.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

git-daemon: daemon.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

git-http-backend: http-backend.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

git-imap-send: imap-send.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

git-sh-i18n--envsubst: sh-i18n--envsubst.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

git-shell: shell.$O common-main.$O libgit.a$O
	$LD -o $target $prereq -lz

libgit.a$O: $OFILES
	ar vu $target $newprereq

%.$O: %.c
	$CC $CFLAGS -c -o $target $stem.c

git.$O: git.c
	$CC $CFLAGS '-DGIT_HTML_PATH="share/doc/git-doc"' '-DGIT_MAN_PATH="share/man"' '-DGIT_INFO_PATH="share/info"' -c -o $target git.c

builtin/help.$O: builtin/help.c
	$CC $CFLAGS '-DGIT_HTML_PATH="share/doc/git-doc"' '-DGIT_MAN_PATH="share/man"' '-DGIT_INFO_PATH="share/info"' -c -o $target builtin/help.c

attr.$O: attr.c
	$CC $CFLAGS '-DETC_GITATTRIBUTES="etc/gitattributes"' -c -o $target attr.c

config.$O: config.c
	$CC $CFLAGS '-DETC_GITCONFIG="etc/gitconfig"' -c -o $target config.c

exec-cmd.$O: exec-cmd.c
	$CC $CFLAGS '-DGIT_EXEC_PATH="/bin/git-scm"' '-DGIT_LOCALE_PATH="share/locale"' '-DBINDIR="/bin/git-scm"' '-DFALLBACK_RUNTIME_PREFIX="/sys/lib/git-scm"' -c -o $target exec-cmd.c

gettext.$O: gettext.c
	$CC $CFLAGS '-DGIT_LOCALE_PATH="share/locale"' -c -o $target gettext.c

help.$O: help.c
	$CC $CFLAGS '-DGIT_HOST_CPU="'$objtype'"'  -c -o $target help.c

pager.$O: pager.c
	$CC $CFLAGS '-DPAGER_ENV="LESS=FRX LV=-c"' -c -o $target pager.c

setup.$O: setup.c
	$CC $CFLAGS '-DDEFAULT_GIT_TEMPLATE_DIR="share/git-core/templates"' -c -o $target setup.c

compat/regex/regex.$O: compat/regex/regex.c
	$CC $CFLAGS '-DGAWK' '-DNO_MBSUPPORT' -c -o $target compat/regex/regex.c

install:V: all
	mkdir -p $BIN $LIB/share/git-core
	for(i in $PROGS) cp $i $BIN/$i
	for(i in $SCRIPTS) {
		cp scripts/$i $BIN/$i
		chmod +x $BIN/$i
	}
	for(i in $DASHED) {
		echo '#!/bin/rc' >$BIN/git-$i
		echo 'exec /bin/git-scm/git '$i' $*' >>$BIN/git-$i
		chmod +x $BIN/git-$i
	}
	rm -rf $LIB/share/git-core/templates
	for(i in $TMPLDIRS) mkdir -p $LIB/share/git-core/$i
	for(i in $TMPLFILES) cp $i $LIB/share/git-core/$i

installall:V:
	for(objtype in $CPUS) mk $MKFLAGS install

clean:V:
	rm -f $PROGS libgit.a[$OS] *.[$OS] */*.[$OS] */*/*.[$OS]

nuke:V: clean
